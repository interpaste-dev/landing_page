export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  color?: string;
  class?: string;
}

const { name, size = 16, stroke = 1.8, color = 'currentColor', class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
