---
import Icon, { type IconName } from './Icon.astro';
import Button from './Button.astro';

const release = {
  version: 'v0.9.2',
  date: '2026-09-22',
  title: 'Udostępnianie ekranu w 1440p i 60 FPS',
  items: [
    'Transmisja szyfrowana SFrame, jak głos',
    'Szybka odpowiedź z overlayu w grze',
    'Ostrzeżenie o kluczu niezgodnym z serwerem',
  ],
};

const posts: { tag: string; tone: 'ok' | 'accent'; icon: IconName; date: string; title: string; text: string }[] = [
  {
    tag: 'Bezpieczeństwo',
    tone: 'ok',
    icon: 'shield',
    date: '2026-09-22',
    title: 'Czym jest szyfrowanie end-to-end i jak działa MLS',
    text: 'Wyjaśniamy bez żargonu, dlaczego serwer widzi tylko szum i co się dzieje z kluczami, gdy ktoś dołącza do grupy.',
  },
  {
    tag: 'Dla graczy',
    tone: 'accent',
    icon: 'gamepad',
    date: '2026-09-08',
    title: 'Push-to-talk, który nie gubi pierwszych słów',
    text: 'Jak działa bufor przed naciśnięciem klawisza i jak go ustawić.',
  },
  {
    tag: 'Bezpieczeństwo',
    tone: 'ok',
    icon: 'shield',
    date: '2026-09-01',
    title: 'Numery bezpieczeństwa: kiedy i po co je porównywać',
    text: 'Minuta na żywo albo przez telefon chroni przed podszyciem się pod znajomego.',
  },
];

const fmt = (iso: string) => new Intl.DateTimeFormat('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(iso));
---

<section id="nowosci" class="container news">
  <div class="head">
    <div class="titles">
      <span class="eyebrow">Nowości</span>
      <h2 class="h2">Co nowego</h2>
    </div>
    <div class="links">
      <Button variant="outline" href="#nowosci">Wszystkie wpisy</Button>
      <Button variant="muted" href="#nowosci">Lista zmian</Button>
    </div>
  </div>

  <div class="layout">
    <article class="release">
      <div class="release-meta">
        <span class="mono version">{release.version}</span>
        <time datetime={release.date}>{fmt(release.date)}</time>
      </div>
      <h3>{release.title}</h3>
      <ul>
        {
          release.items.map((i) => (
            <li>
              <Icon name="check" stroke={2.4} color="var(--ok)" />
              {i}
            </li>
          ))
        }
      </ul>
    </article>

    <div class="posts">
      {
        posts.map((p) => (
          <article class="post">
            <div class:list={['thumb', p.tone]} aria-hidden="true">
              <Icon name={p.icon} size={56} stroke={1.4} />
            </div>
            <div class="post-meta">
              <span class:list={['tag', p.tone]}>{p.tag}</span>
              <time datetime={p.date}>{fmt(p.date)}</time>
            </div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .news {
    padding-top: 60px;
    padding-bottom: 120px;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 32px;
  }
  .titles {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .links {
    display: flex;
    gap: 10px;
  }
  .layout {
    display: flex;
    gap: 32px;
    align-items: stretch;
  }
  .release {
    width: 420px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--accent-line);
  }
  .release-meta,
  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-3);
  }
  .version {
    color: var(--accent);
  }
  .release h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 700;
  }
  .release ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .release li {
    display: flex;
    gap: 10px;
    font-size: 14.5px;
    color: var(--text-2);
  }
  .release li :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .posts {
    flex-grow: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .post {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .thumb {
    position: relative;
    height: 150px;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 16px 18px;
  }
  .thumb::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(241 236 228 / 0.07) 1px, transparent 1.4px);
    background-size: 20px 20px;
  }
  .thumb.ok {
    background: linear-gradient(135deg, #2b3a30 0%, #18211c 100%);
    color: var(--ok);
  }
  .thumb.accent {
    background: linear-gradient(135deg, #3d2c22 0%, #1f1813 100%);
    color: var(--accent);
  }
  .tag {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 12px;
    background: var(--surface-2);
    font-size: 12px;
    font-weight: 600;
  }
  .tag.ok {
    color: var(--ok);
  }
  .tag.accent {
    color: var(--accent);
  }
  .post h3 {
    margin: 0;
    font-size: 19px;
    line-height: 1.3;
    font-weight: 700;
  }
  .post p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-2);
  }

  @media (max-width: 1240px) {
    .layout {
      flex-direction: column;
    }
    .release {
      width: 100%;
    }
  }
  @media (max-width: 900px) {
    .posts {
      grid-template-columns: 1fr;
    }
    .post {
      display: grid;
      grid-template-columns: 140px 1fr;
      grid-template-rows: auto auto 1fr;
      column-gap: 18px;
      row-gap: 8px;
    }
    .thumb {
      grid-row: 1 / span 3;
      height: 110px;
      padding: 10px 12px;
    }
    .thumb :global(svg) {
      width: 36px;
      height: 36px;
    }
  }
  @media (max-width: 720px) {
    .news {
      padding-top: 24px;
      padding-bottom: 72px;
    }
    .head {
      flex-direction: column;
      align-items: flex-start;
    }
    .release {
      padding: 20px;
    }
    .release h3 {
      font-size: 20px;
    }
    .post {
      grid-template-columns: 1fr;
    }
    .thumb {
      display: none;
    }
    .post h3 {
      font-size: 17px;
    }
  }
</style>
