---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'outline' | 'muted';
  size?: 'md' | 'lg';
  block?: boolean;
}

const { variant = 'primary', size = 'md', block = false, class: className, ...rest } = Astro.props;
---

<a class:list={['btn', variant, size, { block }, className]} {...rest}><slot /></a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    padding: 0 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      filter 0.15s;
  }
  .lg {
    height: 52px;
    padding: 0 26px;
    font-size: 16px;
  }
  .block {
    width: 100%;
  }
  .primary {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .primary:hover {
    filter: brightness(1.08);
  }
  .outline {
    background: transparent;
    color: var(--text);
    border-color: var(--line-strong);
  }
  .outline:hover {
    border-color: var(--text-3);
  }
  .muted {
    background: var(--surface-3);
    color: var(--text);
  }
  .muted:hover {
    background: #34312e;
  }
</style>
