---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { LINKS, SECTION, SITE } from '../site';
import { LANGS, LOCALE, getLang, localePath, useT, type Lang } from '../i18n/ui';

interface Props {
  /** Adresy tej samej strony w innych językach (do przełącznika języka). */
  alternates: Partial<Record<Lang, string>>;
}

const { alternates } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const home = localePath(lang, '/');
// Na stronie głównej kotwice działają lokalnie, na podstronach prowadzą do strony głównej.
const onHome = Astro.url.pathname === home;
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const link = (href: string) => (href.startsWith('#') ? anchor(href.slice(1)) : href);

const nav = [
  { label: t.nav.features, href: anchor(SECTION.features) },
  { label: t.nav.security, href: anchor(SECTION.security) },
  { label: t.nav.mobile, href: anchor(SECTION.mobile) },
  { label: t.nav.blog, href: localePath(lang, '/blog/') },
  { label: t.nav.faq, href: anchor(SECTION.faq) },
  { label: t.nav.download, href: anchor(SECTION.download) },
];
const langLinks = LANGS.map((l) => ({ lang: l, href: alternates[l] ?? localePath(l, '/') }));
---

<header class="header">
  <div class="container inner">
    <a href={home} class="brand" aria-label={`${SITE.name} — ${t.a11y.home}`}>
      <Logo />
      <span>{SITE.name}</span>
    </a>

    <nav aria-label="Menu" class="nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="actions">
      <nav class="langs" aria-label={t.a11y.language}>
        {
          langLinks.map((l) => (
            <a href={l.href} hreflang={l.lang} lang={l.lang} aria-current={l.lang === lang ? 'true' : undefined} title={LOCALE[l.lang].label}>
              {LOCALE[l.lang].short}
            </a>
          ))
        }
      </nav>
      <Button variant="outline" href={link(LINKS.login)} class="desk">{t.nav.login}</Button>
      <Button href={link(LINKS.register)} class="desk">{t.nav.register}</Button>
    </div>

    <!-- Menu mobilne na Popover API: działa bez JavaScriptu. -->
    <button class="burger" popovertarget="mobile-menu" aria-label={t.a11y.openMenu}>
      <Icon name="menu" size={20} stroke={2} />
    </button>
    <div id="mobile-menu" popover class="sheet">
      <div class="sheet-top">
        <span class="brand"><Logo />{SITE.name}</span>
        <button class="burger" popovertarget="mobile-menu" popovertargetaction="hide" aria-label={t.a11y.closeMenu}>
          <Icon name="close" size={20} stroke={2} />
        </button>
      </div>
      <nav aria-label="Menu" class="sheet-nav">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="sheet-actions">
        <Button href={link(LINKS.register)} size="lg" block>{t.nav.register}</Button>
        <Button variant="outline" href={link(LINKS.login)} size="lg" block>{t.nav.login}</Button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Zamyka menu mobilne po kliknięciu w link kotwicy (bez tego popover zostaje otwarty).
  document.getElementById('mobile-menu')?.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('a')) e.currentTarget.hidePopover?.();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgb(18 17 17 / 0.96);
  }
  @media (min-width: 721px) {
    .header {
      background: rgb(18 17 17 / 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }
  .inner {
    height: 76px;
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 17px;
    color: var(--text);
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 26px;
    font-size: 14.5px;
  }
  .nav a {
    color: var(--text-2);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }
  .nav a:hover {
    color: var(--text);
  }
  .actions {
    margin-left: auto;
    display: flex;
    gap: 10px;
  }
  .langs {
    display: flex;
    align-items: center;
    height: 40px;
    padding: 3px;
    border-radius: 8px;
    border: 1px solid var(--line-strong);
  }
  .langs a {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 9px;
    border-radius: 5px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-3);
    text-decoration: none;
  }
  .langs a[aria-current] {
    background: var(--surface-3);
    color: var(--text);
  }
  .burger {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .sheet {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 16px 24px;
    border: 0;
    background: var(--bg);
    color: var(--text);
    flex-direction: column;
  }
  .sheet:popover-open {
    display: flex;
  }
  .sheet-top {
    height: 64px;
    display: flex;
    align-items: center;
  }
  .sheet-nav {
    display: flex;
    flex-direction: column;
    padding-top: 12px;
  }
  .sheet-nav a {
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .sheet-actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 1100px) {
    .nav {
      display: none;
    }
    .burger {
      display: inline-flex;
      margin-left: 0;
    }
    .sheet-top .burger {
      margin-left: auto;
    }
  }
  @media (max-width: 720px) {
    .inner {
      height: 64px;
    }
    .actions :global(.desk) {
      display: none;
    }
    .langs {
      height: 44px;
    }
    .langs a {
      padding: 0 11px;
    }
    .inner {
      gap: 12px;
    }
  }
</style>
