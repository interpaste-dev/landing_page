---
import Icon, { type IconName } from './Icon.astro';
import { SECTION } from '../site';
import { getLang, useT } from '../i18n/ui';

const t = useT(getLang(Astro.currentLocale)).features;
const icons: IconName[] = ['lock', 'speaker', 'bolt', 'gamepad', 'palette', 'shield'];
const features = t.items.map((f, i) => ({ ...f, icon: icons[i] }));


---

<section id={SECTION.features} class="container features">
  <div class="section-head">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 class="h2">{t.title}</h2>
    <p class="lead">{t.lead}</p>
  </div>
  <ul class="grid">
    {
      features.map((f) => (
        <li class="card">
          <span class="ico">
            <Icon name={f.icon} size={22} />
          </span>
          <div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .features {
    padding-top: 60px;
    padding-bottom: 120px;
  }
  .section-head .lead {
    max-width: 620px;
  }
  .grid {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .ico {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  h3 {
    margin: 0 0 8px;
    font-size: 19px;
    font-weight: 600;
  }
  p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-2);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .features {
      padding-top: 48px;
      padding-bottom: 72px;
    }
    .section-head {
      align-items: flex-start;
      text-align: left;
    }
    .grid {
      margin-top: 28px;
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .card {
      flex-direction: row;
      padding: 18px;
    }
    .ico {
      width: 40px;
      height: 40px;
    }
    h3 {
      font-size: 17px;
      margin-bottom: 4px;
    }
  }
</style>
