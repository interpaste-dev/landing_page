---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import overlay from '../assets/app-overlay.png';
import { LOCALE, getLang, useT } from '../i18n/ui';
import { ROUTES, route } from '../i18n/routes';
import { gamersCopy } from '../i18n/pages/gamers';
import { breadcrumbLd, faqLd } from '../lib/seo';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const c = gamersCopy[lang];
const site = Astro.site!;
const download = route(lang, 'download');
const faq = c.faq.map((f) => ({ ...f, a: f.a.replace('{download}', download) }));

// Zrzut overlayu jest w pierwszym ekranie na desktopie — ładujemy go od razu, w kilku rozmiarach.
const widths = [480, 720, 1080];
const [avif, webp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: overlay, widths, format })),
);
const sizes = '(max-width: 1100px) 92vw, 620px';

const jsonLd = [
  breadcrumbLd(site, [
    { name: t.a11y.homeCrumb, path: route(lang, 'home') },
    { name: c.crumb, path: route(lang, 'gamers') },
  ]),
  faqLd(faq, LOCALE[lang].intl),
];
---

<Base title={c.meta.title} description={c.meta.description} alternates={ROUTES.gamers} jsonLd={jsonLd}>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <Breadcrumbs items={[{ label: t.a11y.homeCrumb, href: route(lang, 'home') }, { label: c.crumb }]} />
        <span class="eyebrow">{c.eyebrow}</span>
        <h1>{c.title}</h1>
        <p class="lead">{c.lead}</p>
        <div class="ctas">
          <Button href={download} size="lg"><Icon name="download" stroke={2} />{c.cta}</Button>
          <Button href={download} size="lg" variant="outline">{c.ctaServer}</Button>
        </div>
      </div>
      <div class="shot">
        <picture>
          <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
          <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
          <img src={webp.src} width="1440" height="900" alt={c.overlayAlt} loading="eager" fetchpriority="high" decoding="async" />
        </picture>
      </div>
    </div>
  </section>

  <section class="container band">
    <h2 class="h2">{c.builtTitle}</h2>
    <ul class="built">
      {
        c.built.map((b) => (
          <li class="card">
            <span class="ico">
              <Icon name={b.icon as IconName} size={22} />
            </span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container band perf">
    <div class="perf-copy">
      <h2 class="h2">{c.perf.title}</h2>
      <p>{c.perf.text}</p>
    </div>
    <dl class="stats">
      {
        c.perf.stats.map((s) => (
          <div class="card">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container band">
    <div class="steps-panel">
      <h2 class="h2">{c.steps.title}</h2>
      <ol class="steps">
        {
          c.steps.items.map((s, i) => (
            <li>
              <span class="num">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container band faq">
    <h2 class="h2">{c.faqTitle}</h2>
    <div class="faq-list">
      {
        faq.map((f, i) => (
          <details open={i === 0}>
            <summary>
              {f.q}
              <Icon name="plus" size={18} stroke={2} class="toggle" />
            </summary>
            <p set:html={f.a} />
          </details>
        ))
      }
    </div>
  </section>

  <section class="container band">
    <div class="final">
      <div>
        <h2 class="h2">{c.final.title}</h2>
        <p>{c.final.text}</p>
      </div>
      <Button href={download} size="lg"><Icon name="download" stroke={2} />{c.final.cta}</Button>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 72px 0 64px;
  }
  .glow {
    position: absolute;
    right: -100px;
    top: 120px;
    width: 1000px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, var(--accent-glow) 0%, transparent 62%);
  }
  .hero-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 56px;
  }
  .hero-copy {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h1 {
    margin: 0;
    font-size: 54px;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
  }
  .shot {
    width: 620px;
    flex-shrink: 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
  }
  .shot img {
    width: 100%;
    height: auto;
  }

  .band {
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .card {
    padding: 24px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .card h3,
  .steps h3 {
    margin: 0 0 8px;
    font-size: 18px;
  }
  .card p,
  .steps p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .built {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .ico {
    width: 44px;
    height: 44px;
    margin-bottom: 18px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .perf {
    display: flex;
    align-items: center;
    gap: 48px;
  }
  .perf-copy {
    width: 480px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .perf-copy p {
    margin: 0;
    color: var(--text-2);
    line-height: 1.55;
  }
  .stats {
    flex: 1 1 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .stats .card {
    display: flex;
    flex-direction: column-reverse;
    gap: 8px;
  }
  dd {
    margin: 0;
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  dt {
    font-size: 14px;
    color: var(--text-2);
  }

  .steps-panel {
    padding: 48px;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .steps {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .num {
    width: 36px;
    height: 36px;
    margin-bottom: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .faq {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .faq-list {
    width: min(820px, 100%);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  details {
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    font-size: 16.5px;
    font-weight: 600;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(.toggle) {
    flex-shrink: 0;
    color: var(--text-3);
    transition: transform 0.2s;
  }
  details[open] summary :global(.toggle) {
    transform: rotate(45deg);
  }
  details p {
    margin: 0;
    padding: 0 22px 18px;
    color: var(--text-2);
    line-height: 1.6;
  }

  .final {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 48px 56px;
    border-radius: 24px;
    border: 1px solid var(--accent-line);
    background: radial-gradient(ellipse at 70% 0%, var(--accent-soft) 0%, transparent 60%), var(--surface);
  }
  .final p {
    margin: 10px 0 0;
    color: var(--text-2);
  }

  @media (max-width: 1100px) {
    .hero-inner,
    .perf {
      flex-direction: column;
      align-items: stretch;
    }
    .shot,
    .perf-copy {
      width: 100%;
    }
    .built {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding: 32px 0 24px;
    }
    h1 {
      font-size: 36px;
    }
    .hero-inner {
      gap: 32px;
    }
    .ctas :global(.btn) {
      width: 100%;
    }
    .shot {
      box-shadow: 0 16px 32px rgb(0 0 0 / 0.45);
    }
    .band {
      padding-top: 36px;
      padding-bottom: 36px;
    }
    .built,
    .stats,
    .steps {
      grid-template-columns: 1fr;
    }
    .steps-panel {
      padding: 24px;
    }
    .steps {
      gap: 24px;
    }
    .faq {
      align-items: stretch;
    }
    .final {
      flex-direction: column;
      align-items: stretch;
      padding: 28px 22px;
    }
    .final :global(.btn) {
      width: 100%;
    }
  }
</style>
