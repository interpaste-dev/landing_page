---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import keyChange from '../assets/app-key-change.png';
import { LOCALE, getLang, useT } from '../i18n/ui';
import { ROUTES, route } from '../i18n/routes';
import { securityCopy } from '../i18n/pages/security';
import { getPosts, postUrl } from '../lib/blog';
import { breadcrumbLd, publisher } from '../lib/seo';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const c = securityCopy[lang];
const site = Astro.site!;

const ids = { keys: 'key-lifecycle', threats: 'threat-model', verify: 'verification', open: 'open-source' };
const toc = (Object.keys(ids) as (keyof typeof ids)[]).map((k) => ({ id: ids[k], label: c.sections[k] }));
const safetyPost = (await getPosts(lang)).find((p) => p.data.translationKey === 'safety-numbers');
const levelTone = { yes: 'ok', partial: 'warn', no: 'bad' } as const;
const isLink = (s: string) => s.startsWith('http');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: c.meta.title,
    description: c.meta.description,
    url: new URL(route(lang, 'security'), site).href,
    inLanguage: LOCALE[lang].intl,
    publisher: publisher(site),
    about: ['End-to-end encryption', 'Messaging Layer Security (RFC 9420)', 'SFrame'],
  },
  breadcrumbLd(site, [
    { name: t.a11y.homeCrumb, path: route(lang, 'home') },
    { name: t.nav.security, path: route(lang, 'security') },
  ]),
];
---

<Base title={c.meta.title} description={c.meta.description} alternates={ROUTES.security} jsonLd={jsonLd}>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">{c.eyebrow}</span>
        <h1>{c.titleA}<br />{c.titleB}</h1>
        <p class="lead">{c.lead}</p>
      </div>
      <nav class="toc" aria-label={c.toc}>
        <span class="toc-title">{c.toc}</span>
        {
          toc.map((i) => (
            <a href={`#${i.id}`}>
              {i.label}
              <Icon name="chevron" color="var(--text-3)" />
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section id={ids.keys} class="container band">
    <h2 class="h2">{c.sections.keys}</h2>
    <p class="lead narrow">{c.keys.lead}</p>
    <ol class="steps">
      {
        c.keys.steps.map((s, i) => (
          <li class="card">
            <div class="step-top">
              <span class="num">{i + 1}</span>
              <span class="mono tag">{s.tag}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id={ids.threats} class="container band">
    <h2 class="h2">{c.sections.threats}</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">{c.threats.cols.threat}</th>
            <th scope="col">{c.threats.cols.level}</th>
            <th scope="col">{c.threats.cols.how}</th>
          </tr>
        </thead>
        <tbody>
          {
            c.threats.rows.map((r) => (
              <tr>
                <th scope="row">{r.threat}</th>
                <td>
                  <span class:list={['level', levelTone[r.level as keyof typeof levelTone]]}>{c.threats.levels[r.level as keyof typeof levelTone]}</span>
                </td>
                <td class="how">{r.how}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id={ids.verify} class="container band verify">
    <div class="verify-copy">
      <h2 class="h2">{c.sections.verify}</h2>
      <p class="lead">{c.verify.text}</p>
      {
        safetyPost && (
          <a class="more" href={postUrl(safetyPost)}>
            {c.verify.link}
            <Icon name="chevron" />
          </a>
        )
      }
    </div>
    <div class="shot">
      <Picture
        src={keyChange}
        alt={c.verify.alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[480, 720, 1080]}
        sizes="(max-width: 1000px) 92vw, 720px"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <section id={ids.open} class="container band">
    <h2 class="h2">{c.sections.open}</h2>
    <ul class="open">
      {
        c.open.items.map((o) => (
          <li class="card">
            <span class="ico">
              <Icon name={o.icon as IconName} size={22} />
            </span>
            <h3>{o.title}</h3>
            <p>{o.text}</p>
            {isLink(o.note) ? (
              <a class="mono note" href={o.note}>
                {o.note.replace('https://', '')}
              </a>
            ) : (
              <span class="mono note">{o.note}</span>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 88px 0 72px;
  }
  .glow {
    position: absolute;
    right: -200px;
    top: -260px;
    width: 900px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, var(--accent-glow) 0%, transparent 62%);
  }
  .hero-inner {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 620px;
  }
  h1 {
    margin: 0;
    font-size: 60px;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .toc {
    width: 400px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    padding: 18px 20px;
    border-radius: 18px;
    background: rgb(24 23 22 / 0.9);
    border: 1px solid var(--line);
  }
  .toc-title {
    padding-bottom: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .toc a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--accent);
  }

  .band {
    padding-top: 72px;
    padding-bottom: 72px;
  }
  .narrow {
    max-width: 640px;
    margin-top: 14px;
  }
  .card {
    padding: 24px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .card h3 {
    margin: 0 0 8px;
    font-size: 18px;
  }
  .card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .steps,
  .open {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .steps {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .open {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 14px;
  }
  .tag {
    font-size: 12.5px;
    color: var(--text-3);
  }

  .table-wrap {
    margin-top: 32px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--surface);
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  thead th {
    padding: 16px 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    text-align: left;
  }
  tbody th,
  tbody td {
    padding: 16px 20px;
    border-top: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  tbody th {
    font-weight: 600;
    min-width: 220px;
  }
  .how {
    color: var(--text-2);
  }
  .level {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    white-space: nowrap;
  }
  .level::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
  .level.ok {
    color: var(--ok);
  }
  .level.warn {
    color: var(--warn);
  }
  .level.bad {
    color: #f07167;
  }

  .verify {
    display: flex;
    align-items: center;
    gap: 64px;
  }
  .verify-copy {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    text-decoration: none;
  }
  .shot {
    width: 720px;
    flex-shrink: 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
  }
  .ico {
    display: flex;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .note {
    display: inline-block;
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-3);
    word-break: break-all;
  }
  a.note {
    color: var(--accent);
  }

  @media (max-width: 1100px) {
    .hero-inner,
    .verify {
      flex-direction: column;
      align-items: stretch;
    }
    .toc,
    .shot {
      width: 100%;
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding: 40px 0 32px;
    }
    h1 {
      font-size: 38px;
    }
    .hero-inner {
      gap: 28px;
    }
    .band {
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .steps,
    .open {
      grid-template-columns: 1fr;
      margin-top: 24px;
    }
    .verify {
      gap: 28px;
    }
    .shot {
      box-shadow: 0 16px 32px rgb(0 0 0 / 0.45);
    }
    table {
      font-size: 14px;
    }
    thead {
      display: none;
    }
    tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 6px 12px;
      padding: 16px;
      border-top: 1px solid var(--line);
    }
    tbody th,
    tbody td {
      padding: 0;
      border: 0;
      min-width: 0;
    }
    .how {
      grid-column: 1 / -1;
    }
  }
</style>
