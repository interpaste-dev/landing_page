---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
import { LOCALE, formatDate, getLang } from '../i18n/ui';
import { route } from '../i18n/routes';
import { CATEGORY_ICONS, helpCopy, type HelpCategory } from '../i18n/pages/help';
import { getHelp, getHelpTranslations, helpUrl, type HelpArticle } from '../lib/help';
import { readingTime } from '../lib/blog';
import { breadcrumbLd, publisher } from '../lib/seo';

interface Props {
  article: HelpArticle;
}

const { article } = Astro.props;
const lang = getLang(Astro.currentLocale);
const c = helpCopy[lang];
const site = Astro.site!;
const { Content } = await render(article);
const alternates = await getHelpTranslations(article);
const all = await getHelp(lang);
const { title, description, category, updatedDate, appliesTo } = article.data;
const url = helpUrl(article);
const help = route(lang, 'help');

// Boczne menu: artykuły pogrupowane po temacie, bieżący temat na górze.
const order = (Object.keys(c.categories) as HelpCategory[]).sort((a, b) => Number(b === category) - Number(a === category));
const groups = order
  .map((key) => ({ key, name: c.categories[key].name, items: all.filter((a) => a.data.category === key) }))
  .filter((g) => g.items.length);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    url: new URL(url, site).href,
    mainEntityOfPage: new URL(url, site).href,
    inLanguage: LOCALE[lang].intl,
    dateModified: updatedDate.toISOString(),
    datePublished: updatedDate.toISOString(),
    articleSection: c.categories[category].name,
    proficiencyLevel: 'Beginner',
    author: { '@type': 'Organization', name: SITE.name, url: site.href },
    publisher: publisher(site),
  },
  breadcrumbLd(site, [
    { name: c.crumb, path: help },
    { name: c.categories[category].name, path: help },
    { name: title, path: url },
  ]),
];
---

<Base title={`${title} | ${c.crumb} ${SITE.name}`} description={description} alternates={alternates} jsonLd={jsonLd}>
  <div class="container layout">
    <aside class="nav">
      <a class="all" href={help}><Icon name="chevron" class="back" />{c.article.allTopics}</a>
      {
        groups.map((g) => (
          <div class="group">
            <span class="g-title">
              <Icon name={CATEGORY_ICONS[g.key]} size={14} />
              {g.name}
            </span>
            <ul>
              {g.items.map((a) => (
                <li>
                  <a href={helpUrl(a)} aria-current={a.id === article.id ? 'page' : undefined}>
                    {a.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </aside>

    <article class="main">
      <Breadcrumbs items={[{ label: c.crumb, href: help }, { label: c.categories[category].name, href: help }, { label: title }]} />
      <h1>{title}</h1>
      <p class="meta">
        {c.article.updated} <time datetime={updatedDate.toISOString().slice(0, 10)}>{formatDate(lang, updatedDate)}</time> · {readingTime(article.body)}
        {c.article.minRead} · {c.article.appliesTo} {appliesTo}
      </p>
      <div class="prose">
        <Content />
      </div>
    </article>

    <aside class="more">
      <span class="m-title">{c.article.needMore}</span>
      <a href={`${help}#contact`}>{c.article.contact}</a>
      <a href={route(lang, 'blog')}>{c.article.blog}</a>
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr) 220px;
    gap: 48px;
    padding-top: 56px;
    padding-bottom: 96px;
    align-items: start;
  }
  .nav,
  .more {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
  }
  .all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .all :global(.back) {
    transform: rotate(180deg);
  }
  .group + .group {
    margin-top: 18px;
  }
  .g-title {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px 6px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav li a {
    display: block;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-2);
    text-decoration: none;
  }
  .nav li a:hover {
    color: var(--text);
  }
  .nav li a[aria-current='page'] {
    background: var(--surface-2);
    color: var(--text);
    font-weight: 600;
  }

  .main {
    min-width: 0;
    max-width: 720px;
  }
  h1 {
    margin: 18px 0 10px;
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .meta {
    margin: 0 0 24px;
    font-size: 13.5px;
    color: var(--text-3);
  }

  .prose {
    font-size: 16.5px;
    line-height: 1.7;
    color: #ded7cd;
  }
  .prose :global(p) {
    margin: 14px 0;
  }
  .prose :global(h2) {
    margin: 36px 0 8px;
    font-size: 22px;
    color: var(--text);
  }
  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text);
  }
  /* Lista numerowana = kroki z kółkiem z numerem. */
  .prose :global(ol) {
    list-style: none;
    counter-reset: step;
    margin: 24px 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .prose :global(ol > li) {
    counter-increment: step;
    position: relative;
    padding-left: 48px;
  }
  .prose :global(ol > li::before) {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 700;
  }
  .prose :global(ol > li > p) {
    margin: 4px 0;
  }
  .prose :global(ol > li > p:first-child) {
    margin-top: 2px;
  }
  .prose :global(ul) {
    padding-left: 22px;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 16px 0 4px;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
  }
  .prose :global(blockquote) {
    margin: 28px 0;
    padding: 16px 20px;
    border-radius: 14px;
    border: 1px solid rgb(230 169 90 / 0.35);
    background: rgb(230 169 90 / 0.08);
    font-size: 15px;
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .prose :global(table) {
    width: 100%;
    margin: 20px 0;
    border-collapse: collapse;
    font-size: 15px;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .prose :global(th) {
    font-size: 12.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .more {
    gap: 10px;
  }
  .m-title {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .more a {
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 1200px) {
    .layout {
      grid-template-columns: 240px minmax(0, 1fr);
    }
    .more {
      grid-column: 2;
      position: static;
    }
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 24px;
      padding-bottom: 64px;
    }
    .nav,
    .more {
      position: static;
      grid-column: auto;
    }
    .main {
      order: -1;
    }
    .nav {
      padding-top: 24px;
      border-top: 1px solid var(--line);
    }
    h1 {
      font-size: 30px;
    }
    .prose {
      font-size: 16px;
    }
    .prose :global(ol > li) {
      padding-left: 42px;
    }
  }
</style>
