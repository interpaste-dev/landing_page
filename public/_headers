# Cloudflare Pages — nagłówki HTTP.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Pliki z hashem w nazwie (CSS, JS, obrazy, fonty z builda) nigdy się nie zmieniają.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Statyczne pliki bez hasha — krótszy cache, żeby podmiana była widoczna w ciągu dnia.
/og.png
  Cache-Control: public, max-age=86400
/favicon.*
  Cache-Control: public, max-age=86400
/icon-*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
/pl/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
/changelog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
/pl/nowosci/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
